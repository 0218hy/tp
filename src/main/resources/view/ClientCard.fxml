<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="5" right="5" bottom="5" left="15" />
    </padding>
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" styleClass="record-card" spacing="8" minHeight="105" GridPane.columnIndex="0">
      <HBox spacing="0.5" alignment="CENTER_LEFT" styleClass="record-card-heading">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" />
      </HBox>
      <FlowPane fx:id="tags" />
      <Label fx:id="phone" styleClass="cell_small_label" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
      <Label fx:id="address" styleClass="cell_small_label" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
      <Label fx:id="email" styleClass="cell_small_label" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
    </VBox>
  </GridPane>
</HBox>
