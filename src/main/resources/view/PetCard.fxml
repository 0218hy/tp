<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" spacing="8" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <Label fx:id="owner" styleClass="owner-heading" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
      <VBox styleClass="record-card" spacing="8">
        <HBox spacing="0.5" alignment="CENTER_LEFT" styleClass="record-card-heading">
          <Label fx:id="id" styleClass="cell_big_label">
            <minWidth>
              <Region fx:constant="USE_PREF_SIZE" />
            </minWidth>
          </Label>
          <Label fx:id="name" styleClass="cell_big_label" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" />
        </HBox>
        <Label fx:id="species" styleClass="cell_small_label" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
        <Label fx:id="breed" styleClass="cell_small_label" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
        <Separator />
        <Label fx:id="requirement" styleClass="cell_small_label, care-highlight" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
      </VBox>
    </VBox>
  </GridPane>
</HBox>
