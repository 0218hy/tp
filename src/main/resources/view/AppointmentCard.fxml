<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS" maxWidth="Infinity">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" minWidth="10" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" spacing="8" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <Label fx:id="dateHeading" styleClass="date-heading" wrapText="true"
             minHeight="-Infinity" maxWidth="Infinity" />
      <VBox styleClass="record-card" spacing="8" fillWidth="true">
        <HBox spacing="0.5" alignment="CENTER_LEFT" styleClass="record-card-heading">
          <Label fx:id="id" styleClass="cell-big-label">
            <minWidth>
              <Region fx:constant="USE_PREF_SIZE" />
            </minWidth>
          </Label>
          <Label fx:id="appointmentTitle" styleClass="cell-big-label" wrapText="true"
                 minHeight="-Infinity" HBox.hgrow="ALWAYS" />
        </HBox>
        <Label fx:id="pet" styleClass="cell-small-label" wrapText="true"
               minHeight="-Infinity" maxWidth="Infinity" />
        <Label fx:id="owner" styleClass="cell-small-label" wrapText="true"
               minHeight="-Infinity" maxWidth="Infinity" />
        <Label fx:id="phone" styleClass="cell-small-label" wrapText="true"
               minHeight="-Infinity" maxWidth="Infinity" />
        <Label fx:id="address" styleClass="cell-small-label" wrapText="true"
               minHeight="-Infinity" maxWidth="Infinity" />
        <Separator />
        <Label fx:id="careNotes" styleClass="cell-small-label, care-highlight" wrapText="true"
               minHeight="-Infinity" maxWidth="Infinity" />
      </VBox>
    </VBox>
  </GridPane>
</HBox>
