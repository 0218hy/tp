@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantPadding 5
skinparam SequenceMessageAlign left
skinparam maxMessageSize 180
title edit-client: change a phone number
caption Example: edit-client i/91234567 p/89998888

Participant ":LogicManager" as logic LOGIC_COLOR
Participant ":BuBuParser" as abp LOGIC_COLOR
Participant ":EditClientCommand\nParser" as ecp LOGIC_COLOR
Participant "command:\nEditClientCommand" as ec LOGIC_COLOR
Participant "model:Model" as model MODEL_COLOR

[-> logic : execute(text)
activate logic
logic -> abp ++: parseCommand(text)
create ecp
abp -> ecp
abp -> ecp ++: parse(arguments)
create ec
ecp -> ec ++: identifier, editClientDescriptor
ec --> ecp --
ecp --> abp --: command
abp --> logic --: command

note over logic, abp
  Take a book snapshot before execution.
end note
logic -> ec ++: execute(model)
ec -> model ++: getBubuBook()\n.getClientList()
model --> ec --: saved clients
note over ec, model
  Find the client by current phone number.
  Reject an unknown identifier or duplicate phone/email.
end note
ec -> model ++: setClient(clientToEdit, editedClient)
note over ec, model
  Replace the client and refresh pet owners.
  Update linked appointment snapshots
  using the historical-record rules.
  Preserve the active client filter.
end note
model --> ec --
ec --> logic --: CommandResult (CLIENTS)
note over logic, abp
  Save changed records.
  Restore the snapshot if saving fails.
end note
[<-- logic : commandResult
deactivate logic

@enduml
