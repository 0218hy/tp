@startuml
!pragma layout smetana
!include style.puml
skinparam dpi 150
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

class BuBuParser
class "<<interface>>\nParser" as Parser

together {
    class EditClientCommandParser
    class EditPetCommandParser
    class EditAppointmentCommandParser
}

together {
    class ClientCliSyntax
    class PetCliSyntax
    class AppointmentCliSyntax
}

class ClientParserUtil
class PetParserUtil
class ParserUtil
class ArgumentTokenizer
class ArgumentMultimap
class Prefix

BuBuParser ..> EditClientCommandParser : <<create>>
BuBuParser ..> EditPetCommandParser : <<create>>
BuBuParser ..> EditAppointmentCommandParser : <<create>>
EditClientCommandParser .up.|> Parser
EditPetCommandParser .up.|> Parser
EditAppointmentCommandParser .up.|> Parser

EditClientCommandParser ..> ClientCliSyntax
EditPetCommandParser ..> PetCliSyntax
EditAppointmentCommandParser ..> AppointmentCliSyntax
ClientCliSyntax ..> Prefix
PetCliSyntax ..> Prefix
AppointmentCliSyntax ..> Prefix

' Helper dependencies are expanded only for the appointment-edit example.
EditAppointmentCommandParser ..> ClientParserUtil
EditAppointmentCommandParser ..> PetParserUtil
EditAppointmentCommandParser ..> ParserUtil
EditAppointmentCommandParser ..> ArgumentTokenizer
EditAppointmentCommandParser ..> ArgumentMultimap
ArgumentTokenizer ..> ArgumentMultimap : <<create>>
ArgumentTokenizer ..> Prefix
ArgumentMultimap --> "*" Prefix : keys

legend bottom
  Partial diagram: one example parser per feature.
  Each implements Parser for its matching command type.
  Command classes and other feature parsers are omitted.
  Helper dependencies are expanded only for EditAppointmentCommandParser.
endlegend
@enduml
