@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

title Core model records used by client and appointment commands

BubuBook *-right-> "1" UniqueClientList
BubuBook *-down-> "1" UniquePetList
BubuBook *-left-> "1" AppointmentList

UniqueClientList -right-> "*" Client
UniquePetList -right-> "*" Pet
AppointmentList -right-> "*" Appointment

Pet --> "1 owner" Client
Appointment --> "1 owner" Client
Appointment --> "1 pet" Pet

note right of BubuBook
  Removing a client also removes
  its pets and appointments.
end note
@enduml
