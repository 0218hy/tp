@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyClientBook" as ReadOnlyClientBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class ClientBook
Class PetBook
Class AppointmentBook
Class "<<interface>>\nReadOnlyPetBook" as ReadOnlyPetBook
Class "<<interface>>\nReadOnlyAppointmentBook" as ReadOnlyAppointmentBook
Class Appointment
Class ModelManager
Class UserPrefs

Class UniqueClientList
Class UniquePetList
Class Client
Class Pet
Class Address
Class Email
Class ClientName
Class Phone
Class Tag
Class PetName
Class Species
Class Requirement

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

ClientBook .up.|> ReadOnlyClientBook
PetBook .up.|> ReadOnlyPetBook
AppointmentBook .up.|> ReadOnlyAppointmentBook
AppointmentBook *--> "*" Appointment

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyClientBook
Model --> ReadOnlyPetBook
Model --> ReadOnlyAppointmentBook
ModelManager -left-> "1" ClientBook
ModelManager --> "1" PetBook
ModelManager --> "1" AppointmentBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

ClientBook *--> "1" UniqueClientList
PetBook *--> "1" UniquePetList
UniqueClientList --> "~* all" Client
UniquePetList --> "~* all" Pet
Client *--> ClientName
Client *--> Phone
Client *--> Email
Client *--> Address
Client *--> "*" Tag
Pet *--> PetName
Pet *--> Species
Pet *--> Requirement
Pet --> "1 owner" Client

Client -[hidden]up--> I
UniqueClientList -[hidden]right-> I

ClientName -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "~* filtered" Client
ModelManager --> "~* filtered" Pet
@enduml
