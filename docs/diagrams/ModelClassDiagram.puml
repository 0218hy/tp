@startuml
' Use the model colors and class styling from style.puml without sequence-only settings.
!define MODEL_COLOR #9D0012
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam class {
    FontColor #FFFFFF
    FontSize 15
    BorderThickness 1
    BorderColor #FFFFFF
    StereotypeFontColor #FFFFFF
    FontName Arial
    AttributeFontColor #FFFFFF
    AttributeFontSize 13
    AttributeFontName Arial
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderThickness 1
    FontSize 16
}
skinparam DefaultTextAlignment center
skinparam packageStyle Rectangle
skinparam Shadowing false

title Model component: API, collections, and records

package "Model API and coordination" {
    interface Model
    interface ReadOnlyBubuBook
    interface ReadOnlyUserPrefs
    class ModelManager
    class UserPrefs
}

package "Shared book and collections" {
    class BubuBook
    class UniqueClientList
    class UniquePetList
    class AppointmentList
}

package "Domain records" {
    class Client {
        ClientName name
        Phone phone
        Email email
        Address address
        Set<Tag> tags
    }

    class Pet {
        PetName name
        Species species
        Breed breed [optional]
        Requirement groomingRequirements
    }

    class Appointment {
        AppointmentDate date
        StartTime startTime
        EndTime endTime
        Service service
    }
}

ModelManager ..|> Model
BubuBook ..|> ReadOnlyBubuBook
UserPrefs ..|> ReadOnlyUserPrefs
Model ..> ReadOnlyBubuBook : exposes
Model ..> ReadOnlyUserPrefs : exposes
ModelManager *--> "1" BubuBook
ModelManager *--> "1" UserPrefs

BubuBook *--> "1" UniqueClientList
BubuBook *--> "1" UniquePetList
BubuBook *--> "1" AppointmentList
UniqueClientList *--> "*" Client : unique by phone or email
UniquePetList *--> "*" Pet : unique per owner phone and normalized name
AppointmentList *--> "*" Appointment : rejects overlap; allows adjacent slots

Pet --> "1 owner" Client
Appointment --> "1 owner snapshot" Client
Appointment --> "1 pet snapshot" Pet

note right of ModelManager
  Maintains filtered and sorted
  observable display views.
end note

note bottom of BubuBook
  Replacements are validated before application.
  Client edits refresh pet owners and propagate changed phones
  to appointment snapshots. Pet renames update appointment names.
  Removing a client or pet removes its related records.
end note
@enduml
