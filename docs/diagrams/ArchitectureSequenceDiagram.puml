@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
title Command execution: saving and rollback for delete-client 1

actor User as user USER_COLOR
participant "ui:UI" as ui UI_COLOR
participant "logic:Logic" as logic LOGIC_COLOR
participant "model:Model" as model MODEL_COLOR
participant "storage:Storage" as storage STORAGE_COLOR

user -> ui : submit "delete-client 1"
activate ui UI_COLOR
ui -> logic : execute("delete-client 1")
activate logic LOGIC_COLOR

logic -> model : retrieve current data
activate model MODEL_COLOR
model --> logic : current data
deactivate model

logic -> logic : copy current data
activate logic LOGIC_COLOR_T1
logic --> logic : backup copy
deactivate logic

logic -> model : apply validated command
activate model MODEL_COLOR
model --> logic : model updated
deactivate model

logic -> model : retrieve updated data
activate model MODEL_COLOR
model --> logic : updated data
deactivate model

logic -> storage : save updated data
activate storage STORAGE_COLOR
storage --> logic : save completed / save failed
deactivate storage

opt save failed
    logic -> model : restore backup copy
    activate model MODEL_COLOR
    model --> logic : previous data restored
    deactivate model
end

logic --> ui : command outcome
deactivate logic
ui --> user : success / storage error feedback
deactivate ui
@enduml
