@startuml
!include style.puml
skinparam ArrowFontStyle plain
title Architecture flow for delete-client

Actor User as user USER_COLOR
Participant ":UI" as ui UI_COLOR
Participant ":Logic" as logic LOGIC_COLOR
Participant ":Model" as model MODEL_COLOR
Participant ":Storage" as storage STORAGE_COLOR

user -[USER_COLOR]> ui : "delete-client 1"
activate ui UI_COLOR

ui -[UI_COLOR]> logic : execute("delete-client 1")
activate logic LOGIC_COLOR

logic -[LOGIC_COLOR]> model : deleteClient(clientToDelete)
activate model MODEL_COLOR
note right of model
  The model removes the client and
  cascades removal to owned pets and
  related appointments.
end note
model -[MODEL_COLOR]-> logic
deactivate model

logic -[LOGIC_COLOR]> storage : saveBubuBook(bubuBook)
activate storage STORAGE_COLOR
storage -[STORAGE_COLOR]> storage : save to file
storage --[STORAGE_COLOR]> logic
deactivate storage

logic --[LOGIC_COLOR]> ui : CommandResult
deactivate logic

ui -[UI_COLOR]> user : success message
deactivate ui
@enduml
