@startuml
!pragma layout smetana
!include style.puml
skinparam dpi 150
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {
    class "<<interface>>\nLogic" as Logic
    class LogicManager
    class BuBuParser
    abstract class Command
    class CommandResult
    enum "CommandResult.DisplayType" as DisplayType

    package "Example commands" {
        class EditClientCommand
        class EditPetCommand
        class EditAppointmentCommand
    }
}

class "<<interface>>\nModel" as Model MODEL_COLOR
class "<<interface>>\nStorage" as Storage STORAGE_COLOR

LogicManager .up.|> Logic
LogicManager --> "1" BuBuParser
LogicManager --> "1" Model
LogicManager --> "1" Storage
LogicManager ..> Command : executes
BuBuParser ..> Command : returns
Command ..> Model : execute(model)
Command ..> CommandResult : returns
Logic ..> CommandResult : returns
CommandResult --> "1" DisplayType
LogicManager ..> DisplayType : tracks current list

EditClientCommand -up-|> Command
EditPetCommand -up-|> Command
EditAppointmentCommand -up-|> Command

note bottom of BuBuParser
  Feature parsers are expanded
  in the parser class diagram.
end note

note bottom of DisplayType
  CLIENTS, PETS, APPOINTMENTS, UNCHANGED
end note
@enduml
