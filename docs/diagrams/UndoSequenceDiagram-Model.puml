@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedGroomingBook" as VersionedGroomingBook MODEL_COLOR
end box

[-> Model : undoGroomingBook()
activate Model

Model -> VersionedGroomingBook : undo()
activate VersionedGroomingBook

VersionedGroomingBook -> VersionedGroomingBook :resetData(ReadOnlyGroomingBook)
VersionedGroomingBook --> Model :
deactivate VersionedGroomingBook

[<-- Model
deactivate Model

@enduml
