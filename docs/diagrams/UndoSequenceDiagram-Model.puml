@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedBubuBook" as VersionedBubuBook MODEL_COLOR
end box

[-> Model : undoBubuBook()
activate Model

Model -> VersionedBubuBook : undo()
activate VersionedBubuBook

VersionedBubuBook -> VersionedBubuBook :resetData(ReadOnlyBubuBook)
VersionedBubuBook --> Model :
deactivate VersionedBubuBook

[<-- Model
deactivate Model

@enduml
