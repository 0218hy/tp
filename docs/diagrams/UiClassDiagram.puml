@startuml
!include style.puml
!pragma layout smetana
skinparam nodesep 50
skinparam ranksep 85
skinparam padding 8
skinparam arrowThickness 1.5
skinparam ArrowFontSize 12
skinparam ArrowFontStyle plain
skinparam classBorderColor UI_COLOR_T4
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI {
interface Ui <<interface>>
class UiManager
class MainWindow
class CommandBox
class ResultDisplay
class StatusBarFooter
class ClientListPanel
class PetListPanel
class AppointmentListPanel
class ClientCard
class PetCard
class AppointmentCard

UiManager .left.|> Ui : implements
UiManager -down-> "0..1" MainWindow
MainWindow *-down-> "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" StatusBarFooter
MainWindow *-down-> "1" ClientListPanel
MainWindow *-down-> "1" PetListPanel
MainWindow *-down-> "1" AppointmentListPanel
ClientListPanel .down.> ClientCard : creates\nvia cells
PetListPanel .down.> PetCard : creates\nvia cells
AppointmentListPanel .down.> AppointmentCard : creates\nvia cells

' Invisible constraints only arrange the boxes; all semantic relationships above are visible.
CommandBox -[hidden]right-> ResultDisplay
ResultDisplay -[hidden]right-> StatusBarFooter
StatusBarFooter -[hidden]right-> ClientListPanel
ClientListPanel -[hidden]right-> PetListPanel
PetListPanel -[hidden]right-> AppointmentListPanel
}

@enduml
